#!/usr/bin/env python3
"""Wrapper to invoke Openpilot Fork Manager CLI"""
import os
import sys

# Ensure project root on PYTHONPATH before importing modules
package_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if package_root not in sys.path:
    sys.path.insert(0, package_root)

from fork_manager.cli import main

if __name__ == "__main__":
    sys.exit(main())
