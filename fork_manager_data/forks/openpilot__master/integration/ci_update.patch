diff --git a/.github/workflows/selfdrive_tests.yaml b/.github/workflows/selfdrive_tests.yaml
index e3f5a12..abcdef0 100644
--- a/.github/workflows/selfdrive_tests.yaml
+++ b/.github/workflows/selfdrive_tests.yaml
@@ jobs:
   unit_tests:
     name: unit tests
@@
         chmod -R 777 /tmp/comma_download_cache"
+
+  ui_qtest:
+    name: UI QTest
+    runs-on: ubuntu-latest
+    needs: build
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: true
+      - name: Setup Qt Environment
+        run: |
+          sudo apt-get update && sudo apt-get install -y qt5-default qtbase5-dev
+      - name: Build UI Tests
+        run: |
+          mkdir -p build/ui_tests && cd build/ui_tests && qmake ../../../selfdrive/ui/qt/offroad/SoftwareManagerPanel.pro && make -j$(nproc)
+      - name: Run UI Tests
+        env:
+          QT_QPA_PLATFORM: offscreen
+        run: |
+          cd build/ui_tests && ./test_software_manager_panel --gtest_output=xml:results/ui_test_results.xml
+      - uses: actions/upload-artifact@v2
+        with:
+          name: ui_test_results
+          path: build/ui_tests/results/ui_test_results.xml
